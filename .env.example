# --- pick the vector backend -------------------------------------------------
# local  -> Chroma, stored on disk (default, offline, no account)
# cloud  -> Qdrant Cloud (set QDRANT_URL + QDRANT_API_KEY below)
VECTOR_BACKEND=local

# --- embeddings (local, small + fast — no API key) ---------------------------
EMBED_MODEL=all-MiniLM-L6-v2

# --- shared knobs ------------------------------------------------------------
COLLECTION_NAME=solved_issues
MIN_SCORE=0.30
# DB_PATH=./memory_db        # where Chroma stores its files (local backend only)

# --- cloud backend only ------------------------------------------------------
# QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# --- optional read-only web dashboard ----------------------------------------
# Off by default. Turn it on and it autostarts with the MCP server (so it's up
# whenever Claude has the server open) and serves a page that shows the stored
# memories. Binds to localhost only unless you change WEB_HOST.
# WEB_UI=on              # 1/on/true/yes enables; unset/anything else = off
# WEB_PORT=8765          # port to serve on
# WEB_HOST=127.0.0.1     # bind address; set 0.0.0.0 only to expose on your network
